{
 "format": "hexmarch-procedures/1",
 "rules": [
  "e9",
  "e9mm",
  "mm"
 ],
 "_comment": "E9's generic procedures (EVENTS_FORMAT.md section 7). travel and sight-range are the questions the Atlas asks; a module's own terrain travel and sight fields win on its map. The sight ranges are the Atlas's stand-in numbers until the handbook's are worded in. mm uses this file until mm-core has its own. navigate and move are mechanical only (time and position); the rolls along the way belong to each ruleset's own thread. travel, terrain-kind and move follow e9-core's movement data (movement.md); e9-* helpers are internal.",
 "procedures": {
  "travel": {
   "params": [
    "terrain",
    "road"
   ],
   "steps": [
    {
     "result": {
      "by": "terrain",
      "of": {
       "mount": 2,
       "mountains": 2,
       "barren-mountains": 2,
       "forest": 2,
       "bog": 2,
       "marsh": 2,
       "swamp": 2,
       "lake": 2,
       "sea": 2,
       "ocean": 2,
       "deep-ocean": 2,
       "shallows": 2
      },
      "else": 1
     }
    }
   ]
  },
  "sight-range": {
   "params": [
    "terrain"
   ],
   "steps": [
    {
     "result": {
      "by": "terrain",
      "else": 3,
      "of": {
       "grass": 3,
       "woods": 1.5,
       "forest": 0.5,
       "hills": 6,
       "mount": 12,
       "bog": 2,
       "sea": 6,
       "lake": 3,
       "clear": 3,
       "mixed-woods": 1.5,
       "grassland": 3,
       "mountains": 12,
       "barren-mountains": 12,
       "scrub-desert": 4,
       "sandy-desert": 4,
       "rocky-desert": 4,
       "marsh": 2,
       "swamp": 1,
       "black-sand": 4,
       "deep-ocean": 6,
       "ocean": 6,
       "shallows": 6
      }
     }
    }
   ]
  },
  "navigate": {
   "offer": "hex",
   "label": "Navigate to here",
   "about": "Move the party hex by hex along the way, passing time on its clock and stopping where something happens.",
   "default": true,
   "params": [
    "to"
   ],
   "steps": [
    {
     "walk": "move",
     "stop": "queued"
    }
   ]
  },
  "move": {
   "params": [
    "from",
    "to",
    "terrain",
    "road",
    "mi",
    "mph",
    "pace",
    "party",
    "kind",
    "speed",
    "modes"
   ],
   "about": "Time for one hex: pace is the hex's travel multiplier and speed the party's (slowest member's slowest mode, rules.json movement). On difficult ground Climb/Swim/Maneuver's 0.5x is the slowdown, so the travel multiplier's own 2x is taken out once (movement.md).",
   "steps": [
    {
     "call": "e9-kind-base",
     "with": {
      "kind": "{kind}"
     },
     "as": "base"
    },
    {
     "effect": "clock",
     "hours": "{mi} * {pace} / ({mph} * {speed} * {base})"
    },
    {
     "effect": "move",
     "to": "{to}"
    },
    {
     "effect": "reveal",
     "from": "{to}"
    }
   ]
  },
  "terrain-kind": {
   "params": [
    "terrain",
    "road",
    "travel"
   ],
   "about": "Heph 2026-11-15: mountain, heavy forest, marshland and water are difficult (rules.json movement.terrain.difficultTerrain); a road makes any hex open.",
   "steps": [
    {
     "call": "e9-road-kind",
     "with": {
      "road": "{road}"
     },
     "as": "rk"
    },
    {
     "call": "e9-terrain-kind",
     "with": {
      "terrain": "{terrain}"
     },
     "as": "tk"
    },
    {
     "call": "e9-kind-of",
     "with": {
      "key": "{rk}-{tk}"
     },
     "as": "kind"
    },
    {
     "result": "{kind}"
    }
   ]
  },
  "e9-road-kind": {
   "params": [
    "road"
   ],
   "steps": [
    {
     "result": {
      "by": "road",
      "of": {
       "roman": "open",
       "local": "open",
       "trail": "open"
      },
      "else": "none"
     }
    }
   ]
  },
  "e9-terrain-kind": {
   "params": [
    "terrain"
   ],
   "steps": [
    {
     "result": {
      "by": "terrain",
      "of": {
       "mount": "difficult",
       "mountains": "difficult",
       "barren-mountains": "difficult",
       "forest": "difficult",
       "bog": "difficult",
       "marsh": "difficult",
       "swamp": "difficult",
       "lake": "difficult",
       "sea": "difficult",
       "ocean": "difficult",
       "deep-ocean": "difficult",
       "shallows": "difficult"
      },
      "else": "open"
     }
    }
   ]
  },
  "e9-kind-of": {
   "params": [
    "key"
   ],
   "steps": [
    {
     "result": {
      "by": "key",
      "of": {
       "none-difficult": "difficult"
      },
      "else": "open"
     }
    }
   ]
  },
  "e9-kind-base": {
   "params": [
    "kind"
   ],
   "steps": [
    {
     "result": {
      "by": "kind",
      "of": {
       "difficult": 2
      },
      "else": 1
     }
    }
   ]
  }
 }
}
