{
 "format": "hexmarch-procedures/1",
 "rules": [
  "e9",
  "e9mm",
  "mm"
 ],
 "_comment": "E9's generic procedures (EVENTS_FORMAT.md section 7). sight-range answers by the hex's view grade, move times a hex by the party's speed; terrain traits (ATLAS_FORMAT.md) replace travel multipliers. mm uses this file until mm-core has its own. The rolls along the way (footing, lost, forced-march) and their clock triggers belong to the E9 thread.",
 "procedures": {
  "sight-range": {
   "params": [
    "view",
    "terrain"
   ],
   "about": "Miles seen from a hex, by its view grade (rules.json movement.view_mi).",
   "steps": [
    {
     "result": {
      "by": "view",
      "of": {
       "automatic": 6,
       "easy": 3,
       "normal": 1.5,
       "hard": 0.5,
       "impossible": 0
      },
      "else": 3
     }
    }
   ]
  },
  "navigate": {
   "offer": "hex",
   "label": "Navigate to here",
   "about": "Move the party hex by hex along the way, passing time on its clock and stopping where something happens.",
   "default": true,
   "params": [
    "to"
   ],
   "steps": [
    {
     "walk": "move",
     "then": [
      "footing"
     ],
     "stop": "queued"
    }
   ]
  },
  "move": {
   "params": [
    "from",
    "to",
    "terrain",
    "road",
    "mi",
    "mph",
    "pace",
    "party",
    "orient",
    "traverse",
    "hide",
    "investigate",
    "view",
    "speed",
    "modes"
   ],
   "about": "Time for one hex: distance over the party's speed (slowest member's slowest mode, with the hex's traverse grade already applied by the Atlas from rules.json movement). Roll-free, so the Atlas can dry-run it for estimates; the rolls (orient, traverse, hide) run as their own procedures.",
   "steps": [
    {
     "effect": "clock",
     "hours": "{mi} / ({mph} * {speed})"
    },
    {
     "effect": "move",
     "to": "{to}"
    },
    {
     "effect": "reveal",
     "from": "{to}"
    }
   ]
  },
  "e9-grade": {
   "params": [
    "vs"
   ],
   "steps": [
    {
     "result": {
      "by": "vs",
      "of": {
       "automatic": {
        "total": 1
       },
       "easy": {
        "total": 2
       },
       "normal": {
        "total": 3
       },
       "hard": {
        "total": 4
       },
       "impossible": {
        "total": 5
       }
      },
      "else": {
       "total": 3
      }
     }
    }
   ]
  },
  "e9-check": {
   "params": [
    "vs",
    "who"
   ],
   "about": "An E9 talent check (p. 8): automatic passes, easy rolls 2d6 and keeps the better, normal rolls 1d6, hard rolls 2d6 and keeps the worse, impossible fails. The threshold is the default 5+ until the Atlas reads characters' talent thresholds.",
   "steps": [
    {
     "call": "e9-grade",
     "with": {
      "vs": "{vs}"
     },
     "as": "g"
    },
    {
     "branch": "g",
     "ranges": [
      {
       "roll": [
        1,
        1
       ],
       "steps": [
        {
         "result": {
          "pass": true
         }
        }
       ]
      },
      {
       "roll": [
        2,
        2
       ],
       "steps": [
        {
         "roll": "1d6",
         "as": "a"
        },
        {
         "branch": "a",
         "ranges": [
          {
           "roll": [
            5,
            6
           ],
           "steps": [
            {
             "result": {
              "pass": true
             }
            }
           ]
          },
          {
           "roll": [
            1,
            4
           ],
           "steps": [
            {
             "roll": "1d6",
             "as": "b"
            },
            {
             "branch": "b",
             "ranges": [
              {
               "roll": [
                5,
                6
               ],
               "steps": [
                {
                 "result": {
                  "pass": true
                 }
                }
               ]
              },
              {
               "roll": [
                1,
                4
               ],
               "steps": [
                {
                 "result": {
                  "pass": false
                 }
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "roll": [
        3,
        3
       ],
       "steps": [
        {
         "roll": "1d6",
         "as": "a"
        },
        {
         "branch": "a",
         "ranges": [
          {
           "roll": [
            5,
            6
           ],
           "steps": [
            {
             "result": {
              "pass": true
             }
            }
           ]
          },
          {
           "roll": [
            1,
            4
           ],
           "steps": [
            {
             "result": {
              "pass": false
             }
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "roll": [
        4,
        4
       ],
       "steps": [
        {
         "roll": "1d6",
         "as": "a"
        },
        {
         "branch": "a",
         "ranges": [
          {
           "roll": [
            5,
            6
           ],
           "steps": [
            {
             "roll": "1d6",
             "as": "b"
            },
            {
             "branch": "b",
             "ranges": [
              {
               "roll": [
                5,
                6
               ],
               "steps": [
                {
                 "result": {
                  "pass": true
                 }
                }
               ]
              },
              {
               "roll": [
                1,
                4
               ],
               "steps": [
                {
                 "result": {
                  "pass": false
                 }
                }
               ]
              }
             ]
            }
           ]
          },
          {
           "roll": [
            1,
            4
           ],
           "steps": [
            {
             "result": {
              "pass": false
             }
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "roll": [
        5,
        5
       ],
       "steps": [
        {
         "result": {
          "pass": false
         }
        }
       ]
      }
     ]
    }
   ]
  },
  "footing": {
   "params": [
    "traverse",
    "to"
   ],
   "about": "Rolls along the way (movement.md): everyone rolls Agility at the hex's traverse grade on entering it; if anyone fails, the party is bogged down and the walk halts in that hex.",
   "steps": [
    {
     "each": "*",
     "roll": "agility",
     "vs": "{traverse}",
     "combine": "all",
     "as": "r",
     "label": "Footing: Agility vs traverse",
     "ease": "maneuver"
    },
    {
     "branch": "r",
     "fail": [
      {
       "text": "Bogged down: {r.failed} failed Agility ({traverse})."
      },
      {
       "effect": "halt"
      }
     ]
    }
   ]
  },
  "lost": {
   "params": [
    "orient",
    "to"
   ],
   "about": "Rolls along the way (movement.md): each shift, everyone on Navigate rolls Survival at the hex's orient grade, in secret. If nobody passes, the party is lost and the walk halts.",
   "steps": [
    {
     "each": "navigate",
     "roll": "survival",
     "vs": "{orient}",
     "combine": "any",
     "as": "r",
     "secret": true,
     "label": "Lost? Survival vs orient"
    },
    {
     "branch": "r",
     "fail": [
      {
       "text": "Lost: nobody on Navigate kept the way ({orient})."
      },
      {
       "effect": "halt"
      }
     ]
    }
   ]
  },
  "march-grade": {
   "params": [
    "road"
   ],
   "about": "The Forced March roll's grade by road class (rules.json movement.roads): Roman and local roads easy, trails and open ground normal.",
   "steps": [
    {
     "result": {
      "by": "road",
      "of": {
       "roman": "easy",
       "local": "easy",
       "trail": "normal"
      },
      "else": "normal"
     }
    }
   ]
  },
  "forced-march": {
   "params": [
    "road",
    "to"
   ],
   "about": "Rolls along the way (movement.md): each hour of Forced March, every marcher rolls Agility at the road's grade; each one who fails takes 1d6 damage.",
   "steps": [
    {
     "call": "march-grade",
     "with": {
      "road": "{road}"
     },
     "as": "g"
    },
    {
     "each": "forced-march",
     "roll": "agility",
     "vs": "{g}",
     "combine": "each",
     "as": "r",
     "label": "Forced March: Agility vs road"
    },
    {
     "effect": "damage",
     "for": "r.failed",
     "amount": "1d6"
    }
   ]
  }
 },
 "triggers": [
  {
   "id": "lost-shift",
   "name": "Lost? (each shift)",
   "on": "clock",
   "every": {
    "n": 4,
    "unit": "hour"
   },
   "while": "walking",
   "auto": true,
   "run": {
    "call": "lost"
   }
  },
  {
   "id": "forced-march-hour",
   "name": "Forced March hour",
   "on": "clock",
   "every": {
    "n": 1,
    "unit": "hour"
   },
   "while": "walking",
   "if": {
    "mode": "forced-march"
   },
   "auto": true,
   "run": {
    "call": "forced-march"
   }
  }
 ],
 "aliases": {
  "survival": "e9-check",
  "agility": "e9-check",
  "stealth": "e9-check",
  "alertness": "e9-check"
 }
}
