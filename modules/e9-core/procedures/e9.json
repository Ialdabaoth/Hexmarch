{
 "format": "hexmarch-procedures/1",
 "rules": [
  "e9",
  "e9mm",
  "mm"
 ],
 "_comment": "E9's generic procedures (EVENTS_FORMAT.md section 7). sight-range answers by the hex's view grade, move times a hex by the party's speed; terrain traits (ATLAS_FORMAT.md) replace travel multipliers. mm uses this file until mm-core has its own. The rolls along the way (footing, lost, forced-march) and their clock triggers belong to the E9 thread.",
 "procedures": {
  "sight-range": {
   "params": [
    "view",
    "terrain"
   ],
   "about": "Miles seen from a hex, by its view grade (rules.json movement.view_mi).",
   "steps": [
    {
     "result": {
      "by": "view",
      "of": {
       "automatic": 6,
       "easy": 3,
       "normal": 1.5,
       "hard": 0.5,
       "impossible": 0
      },
      "else": 3
     }
    }
   ]
  },
  "navigate": {
   "offer": "hex",
   "label": "Navigate to here",
   "about": "Move the party hex by hex along the way, passing time on its clock and stopping where something happens.",
   "default": true,
   "params": [
    "to"
   ],
   "steps": [
    {
     "walk": "move",
     "stop": "queued"
    }
   ]
  },
  "move": {
   "params": [
    "from",
    "to",
    "terrain",
    "road",
    "mi",
    "mph",
    "pace",
    "party",
    "orient",
    "traverse",
    "hide",
    "investigate",
    "view",
    "speed",
    "modes"
   ],
   "about": "Time for one hex: distance over the party's speed (slowest member's slowest mode, with the hex's traverse grade already applied by the Atlas from rules.json movement). Roll-free, so the Atlas can dry-run it for estimates; the rolls (orient, traverse, hide) run as their own procedures.",
   "steps": [
    {
     "effect": "clock",
     "hours": "{mi} / ({mph} * {speed})"
    },
    {
     "effect": "move",
     "to": "{to}"
    },
    {
     "effect": "reveal",
     "from": "{to}"
    }
   ]
  },
  "e9-grade": {
   "params": [
    "vs"
   ],
   "steps": [
    {
     "result": {
      "by": "vs",
      "of": {
       "automatic": {
        "total": 1
       },
       "easy": {
        "total": 2
       },
       "normal": {
        "total": 3
       },
       "hard": {
        "total": 4
       },
       "impossible": {
        "total": 5
       }
      },
      "else": {
       "total": 3
      }
     }
    }
   ]
  },
  "e9-check": {
   "params": [
    "vs",
    "who"
   ],
   "about": "An E9 talent check (p. 8): automatic passes, easy rolls 2d6 and keeps the better, normal rolls 1d6, hard rolls 2d6 and keeps the worse, impossible fails. The threshold is the default 5+ until the Atlas reads characters' talent thresholds.",
   "steps": [
    {
     "call": "e9-grade",
     "with": {
      "vs": "{vs}"
     },
     "as": "g"
    },
    {
     "branch": "g",
     "ranges": [
      {
       "roll": [
        1,
        1
       ],
       "steps": [
        {
         "result": {
          "pass": true
         }
        }
       ]
      },
      {
       "roll": [
        2,
        2
       ],
       "steps": [
        {
         "roll": "1d6",
         "as": "a"
        },
        {
         "branch": "a",
         "ranges": [
          {
           "roll": [
            5,
            6
           ],
           "steps": [
            {
             "result": {
              "pass": true
             }
            }
           ]
          },
          {
           "roll": [
            1,
            4
           ],
           "steps": [
            {
             "roll": "1d6",
             "as": "b"
            },
            {
             "branch": "b",
             "ranges": [
              {
               "roll": [
                5,
                6
               ],
               "steps": [
                {
                 "result": {
                  "pass": true
                 }
                }
               ]
              },
              {
               "roll": [
                1,
                4
               ],
               "steps": [
                {
                 "result": {
                  "pass": false
                 }
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "roll": [
        3,
        3
       ],
       "steps": [
        {
         "roll": "1d6",
         "as": "a"
        },
        {
         "branch": "a",
         "ranges": [
          {
           "roll": [
            5,
            6
           ],
           "steps": [
            {
             "result": {
              "pass": true
             }
            }
           ]
          },
          {
           "roll": [
            1,
            4
           ],
           "steps": [
            {
             "result": {
              "pass": false
             }
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "roll": [
        4,
        4
       ],
       "steps": [
        {
         "roll": "1d6",
         "as": "a"
        },
        {
         "branch": "a",
         "ranges": [
          {
           "roll": [
            5,
            6
           ],
           "steps": [
            {
             "roll": "1d6",
             "as": "b"
            },
            {
             "branch": "b",
             "ranges": [
              {
               "roll": [
                5,
                6
               ],
               "steps": [
                {
                 "result": {
                  "pass": true
                 }
                }
               ]
              },
              {
               "roll": [
                1,
                4
               ],
               "steps": [
                {
                 "result": {
                  "pass": false
                 }
                }
               ]
              }
             ]
            }
           ]
          },
          {
           "roll": [
            1,
            4
           ],
           "steps": [
            {
             "result": {
              "pass": false
             }
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "roll": [
        5,
        5
       ],
       "steps": [
        {
         "result": {
          "pass": false
         }
        }
       ]
      }
     ]
    }
   ]
  },
  "footing": {
   "params": [
    "traverse",
    "to"
   ],
   "about": "Rolls along the way (movement.md), each shift after Navigate: everyone rolls Agility at the hex's traverse grade, one step easier on a found path and with Help on Climb/Swim/Maneuver (never past easy). Each member who fails chooses: stuck (lose an hour; the party waits or splits) or injured (1d6, keep pace).",
   "steps": [
    {
     "each": "*",
     "roll": "agility",
     "vs": "{traverse}",
     "ease": "maneuver",
     "easier": "flags.path",
     "combine": "each",
     "as": "r",
     "label": "Footing: Agility vs traverse"
    },
    {
     "effect": "choose",
     "for": "r.failed",
     "options": [
      {
       "label": "Stuck (lose an hour)",
       "effects": [
        {
         "effect": "clock",
         "hours": 1
        }
       ]
      },
      {
       "label": "Injured (1d6)",
       "effects": [
        {
         "effect": "damage",
         "amount": "1d6"
        }
       ]
      }
     ]
    }
   ]
  },
  "lost": {
   "params": [
    "orient",
    "to"
   ],
   "about": "Rolls along the way (movement.md), first each shift: everyone on Navigate rolls Survival at the hex's orient grade, in secret. If anyone passes, any drift ends. If nobody passes, the party is lost and drifts off course, still walking.",
   "steps": [
    {
     "each": "navigate",
     "roll": "survival",
     "vs": "{orient}",
     "combine": "any",
     "as": "r",
     "secret": true,
     "label": "Navigate: Survival vs orient"
    },
    {
     "branch": "r",
     "pass": [
      {
       "text": "On course."
      },
      {
       "effect": "drift",
       "dir": 0
      }
     ],
     "fail": [
      {
       "text": "Lost: the party drifts off course ({orient})."
      },
      {
       "effect": "drift",
       "dir": "1d6"
      }
     ]
    }
   ]
  },
  "march-grade": {
   "params": [
    "road"
   ],
   "about": "The Forced March roll's grade by road class (rules.json movement.roads): Roman and local roads easy, trails and open ground normal.",
   "steps": [
    {
     "result": {
      "by": "road",
      "of": {
       "roman": "easy",
       "local": "easy",
       "trail": "normal"
      },
      "else": "normal"
     }
    }
   ]
  },
  "forced-march": {
   "params": [
    "road",
    "to"
   ],
   "about": "Rolls along the way (movement.md): each hour of Forced March, every marcher rolls Agility at the road's grade; each one who fails takes 1d6 damage. One step easier on a found path.",
   "steps": [
    {
     "call": "march-grade",
     "with": {
      "road": "{road}"
     },
     "as": "g"
    },
    {
     "each": "forced-march",
     "roll": "agility",
     "vs": "{g}",
     "combine": "each",
     "as": "r",
     "label": "Forced March: Agility vs road",
     "easier": "flags.path"
    },
    {
     "effect": "damage",
     "for": "r.failed",
     "amount": "1d6"
    }
   ]
  },
  "pathfind": {
   "params": [
    "traverse",
    "to"
   ],
   "about": "Rolls along the way (movement.md), each shift after Navigate: everyone on Pathfinding rolls Survival at the hex's traverse grade. If anyone passes, the party has found a path until the next shift: every Agility and Stealth roll along the way is one step easier (never past easy).",
   "steps": [
    {
     "each": "pathfind",
     "roll": "survival",
     "vs": "{traverse}",
     "combine": "any",
     "as": "r",
     "label": "Pathfinding: Survival vs traverse"
    },
    {
     "branch": "r",
     "pass": [
      {
       "text": "A path found."
      },
      {
       "effect": "flag",
       "name": "path",
       "value": true,
       "until": "shift"
      }
     ]
    }
   ]
  }
 },
 "triggers": [
  {
   "id": "lost-shift",
   "name": "Navigate (each shift)",
   "on": "clock",
   "every": {
    "n": 1,
    "unit": "shift"
   },
   "while": "walking",
   "auto": true,
   "run": {
    "call": "lost"
   }
  },
  {
   "id": "pathfind-shift",
   "name": "Pathfinding (each shift)",
   "on": "clock",
   "every": {
    "n": 1,
    "unit": "shift"
   },
   "while": "walking",
   "auto": true,
   "run": {
    "call": "pathfind"
   }
  },
  {
   "id": "footing-shift",
   "name": "Footing (each shift)",
   "on": "clock",
   "every": {
    "n": 1,
    "unit": "shift"
   },
   "while": "walking",
   "auto": true,
   "run": {
    "call": "footing"
   }
  },
  {
   "id": "forced-march-hour",
   "name": "Forced March hour",
   "on": "clock",
   "every": {
    "n": 1,
    "unit": "hour"
   },
   "while": "walking",
   "if": {
    "mode": "forced-march"
   },
   "auto": true,
   "run": {
    "call": "forced-march"
   }
  }
 ],
 "aliases": {
  "survival": "e9-check",
  "agility": "e9-check",
  "stealth": "e9-check",
  "alertness": "e9-check"
 }
}
